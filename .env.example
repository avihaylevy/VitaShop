# Docker Compose only — the values `docker compose up` injects into the
# containers. Copy to `.env` (git-ignored) and fill in the blanks.
# The manual path (SETUP.md steps 3-4) uses server/.env and client/.env
# instead; this file is not read by npm scripts.
#
# 🔴 THERE ARE NO DEFAULTS. `docker compose up` refuses to start with any
# of the three REQUIRED values (SESSION_SECRET and the two passwords)
# empty — the same contract as the seeder.
#
# ⚠️ Compose reads this file itself: a `$` inside a value is treated as a
# variable reference and silently dropped, and ` #` starts a comment. Use
# letters and digits only, or write `$$` for a literal `$`.

# Session-cookie signing secret. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (any long random string works if Node is not installed)
SESSION_SECRET=

# Your login accounts — they exist only inside the Compose database.
SEED_ADMIN_EMAIL=admin@vitashop.local
SEED_ADMIN_PASSWORD=
SEED_SHOPPER_EMAIL=shopper@vitashop.local
SEED_SHOPPER_PASSWORD=

# OPTIONAL second admin, seeded only when its password is set too.
SEED_REVIEWER_EMAIL=reviewer@vitashop.local
SEED_REVIEWER_PASSWORD=
