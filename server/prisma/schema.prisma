// VitaShop — approved schema, DEC-024.
// Open items deliberately left unresolved (not schema-blocking, DEC-024):
//   1. Address fields — minimal, not yet specced
//   2. TargetAudience — spec's closed list not yet transcribed; left as
//      nullable String rather than an invented enum
//   3. Session — RESOLVED 2026-08-10, DEC-052 Part 2. connect-pg-simple
//      still owns the table; a mirror model is now declared purely to
//      baseline it so `migrate dev` sees no drift. Never client-accessed.
//   4. Cart guest identification mechanism — session_id is a placeholder
//   5. Concurrency (DEC-021) — query-time behavior, not a schema construct
//   6. Hebrew search (ISSUE-010) — deferred
//   7. Popularity — computed from OrderItem at query time, no stored column
//
// Product.slug added post-approval — DEC-033, for seed idempotency.

generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7 requirement) — not here.
datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────

enum UserRole {
  customer
  admin
}

enum UserStatus {
  pending_verification
  active
  disabled
}

enum DosageForm {
  CAPSULE @map("כמוסות")
  TABLET  @map("טבליות")
  DROPS   @map("טיפות")
  POWDER  @map("אבקה")
  SYRUP   @map("סירופ")
}

enum OrderStatus {
  pending_payment
  paid
  processing
  shipped
  delivered
  cancelled
}

// 🔴 MILESTONE-008 Checkpoint B. The THREE methods REQ-F-040 §4.5.1 mandates —
// values taken from the specification, not invented here. DEC-058 as amended
// prices them: self pickup ₪0 always (nothing is shipped, so there is nothing
// to charge for), courier and pickup point ₪30, free when the qualifying total
// reaches ₪249.
// ⚠️ A pickup POINT is still a delivery — goods are transported to a locker or
// shop. Only SELF pickup is free.
enum DeliveryMethod {
  self_pickup
  courier
  pickup_point
}

// The four spec-mandated events (§4.7.5). Additional proposed events
// (favorite_added, ai_agent_opened, ...) are not yet approved — KPI_ANALYTICS.md.
enum FunnelEventType {
  product_view
  add_to_cart
  checkout_started
  purchase_completed
}

// ── Core ──────────────────────────────────────────────

model User {
  id               String     @id @default(uuid())
  firstName        String     @map("first_name")
  lastName         String     @map("last_name")
  email            String     @unique
  passwordHash     String     @map("password_hash")
  phone            String?
  termsAcceptedAt  DateTime   @map("terms_accepted_at") @db.Timestamptz
  role             UserRole   @default(customer)
  status           UserStatus @default(pending_verification)
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz
  // DEC-086 / MILESTONE-012 — the membership club. Flat single-tier;
  // membership is read PER REQUEST wherever it prices anything (the
  // DEC-065 revocation pattern), never cached in the session.
  isClubMember     Boolean    @default(false) @map("is_club_member")
  clubJoinedAt     DateTime?  @map("club_joined_at") @db.Timestamptz
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz

  addresses               Address[]
  orders                  Order[]
  favorites               Favorite[]
  carts                   Cart[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  funnelEvents            FunnelEvent[]
  // The back-reference for OrderStatusHistory.changedBy — who moved an order's
  // status. See that model; null there means a SYSTEM transition.
  orderStatusChanges      OrderStatusHistory[]

  @@map("users")
}

// Fields left minimal — street/city/zip breakdown not yet specced (DEC-024 open item 1)
model Address {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  line1     String
  city      String
  zipCode   String?  @map("zip_code")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("addresses")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime  @map("expires_at") @db.Timestamptz // §4.4.2 — 24-hour validity
  usedAt    DateTime? @map("used_at") @db.Timestamptz // single-use
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz // single-use, §4.4.3

  @@map("password_reset_tokens")
}

// ── Session store — OWNED BY connect-pg-simple, NOT by Prisma ─────────
//
// 🔴 This model exists for ONE reason: to keep `prisma migrate dev` from
// reporting drift. The table is created and maintained by
// connect-pg-simple's own table.sql; the shape here mirrors that DDL and
// must not be "improved" to match Prisma conventions.
//
// 🔴 NEVER read or write this table through the Prisma client.
// express-session owns all normal access through the store API. The one
// direct statement the application issues is DEC-018's session
// invalidation, and it is RAW SQL on the same `pg` pool:
//
//     DELETE FROM session WHERE sess->>'userId' = $1
//
// (MILESTONE-006 clause A8. `sess->>'userId'` returns TEXT — the bound
// parameter must be a string even if the id is numeric, or the delete
// silently matches nothing.)
//
// Baselined, not migrated — DEC-052 Part 2. The table already existed
// when its migration was generated, so that migration was recorded with
// `prisma migrate resolve --applied` and never executed.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// ── Catalogue ─────────────────────────────────────────

model Category {
  id       String    @id @default(uuid())
  nameHe   String    @map("name_he") // DEC-017 — paired
  nameEn   String    @map("name_en")
  products Product[]

  @@map("categories")
}

model Brand {
  id       String    @id @default(uuid())
  name     String // DEC-017 — the stored market name, never translated; DEC-080's sourced Latin FORM lives in nameEn below
  // ISSUE-127a (user-approved 2026-08-15): the brand's manufacturer-verified
  // Latin form, seeded from seed.ts's BRAND_EN map (each entry sourced from
  // the manufacturer's own English branding — DEC-032's no-invention rule).
  // Nullable: a brand without a sourced Latin form simply has none yet.
  nameEn   String?   @map("name_en")
  products Product[]

  @@map("brands")
}

model HealthGoal {
  id       String              @id @default(uuid())
  nameHe   String              @map("name_he") // DEC-017 — paired
  nameEn   String              @map("name_en")
  products ProductHealthGoal[]

  @@map("health_goals")
}

model Product {
  id                     String     @id @default(uuid())
  slug                   String     @unique // stable seed identifier, DEC-033 — never change once shipped
  nameHe                 String     @map("name_he") // field 02 — DEC-017, paired
  nameEn                 String     @map("name_en")
  categoryId             String     @map("category_id") // field 03 — exactly one category
  category               Category   @relation(fields: [categoryId], references: [id])
  brandId                String     @map("brand_id") // field 04
  brand                  Brand      @relation(fields: [brandId], references: [id])
  dosageForm             DosageForm @map("dosage_form") // field 05
  packageQuantity        Int        @map("package_quantity") // field 06, > 0
  usageInstructions      String     @map("usage_instructions") @db.Text // field 07 — Hebrew only, manufacturer text
  price                  Decimal    @db.Decimal(10, 2) // field 08 — never Float
  stockQuantity          Int        @default(0) @map("stock_quantity") // field 09, >= 0
  descriptionHe          String     @map("description_he") @db.Text // field 11 — DEC-017, paired
  descriptionEn          String     @map("description_en") @db.Text
  // Pass 131 (DEC-111, the user's ask): the CARD's one-to-two-line teaser —
  // "what the product is for, and why" — separate from the detail page's
  // full description. Paired like it (DEC-017). Default '' so existing
  // rows migrate clean; the catalog DTO falls back to the description's
  // first sentence while empty.
  shortDescriptionHe     String     @default("") @map("short_description_he") @db.Text
  shortDescriptionEn     String     @default("") @map("short_description_en") @db.Text
  warningsAllergens      String     @map("warnings_allergens") @db.Text // field 12 — Hebrew only, manufacturer text
  // DEC-032 DECISION B (Accepted 2026-08-12). 🔴 PROVENANCE, NOT ABSENCE: this
  // is a claim about the SOURCE, not about the product. True means the
  // official page was checked and warningsAllergens already holds everything
  // it publishes — which may be a partial declaration, or nothing at all.
  // It COMPOSES with warningsAllergens rather than replacing it; the four
  // states are (false,"")=not checked, (false,text)=declared,
  // (true,"")=nothing published, (true,text)=partial and that is all there is.
  // A row with this true must NEVER render an empty allergen section.
  allergenInfoIncomplete Boolean    @default(false) @map("allergen_info_incomplete")
  targetAudience         String?    @map("target_audience") // field 15 — TBD closed list, DEC-024 open item 2
  // DEC-083 (Accepted 2026-08-15). 🔴 NULL MEANS UNKNOWN, never false: these
  // are sourced-only claims (DEC-032 — an unsourced "kosher" is an invented
  // claim about a real product). A value is written only when a manufacturer
  // page states it; the catalogue filters match `true` only (DEC-078).
  isKosher               Boolean?   @map("is_kosher")
  isGlutenFree           Boolean?   @map("is_gluten_free")
  isVegan                Boolean?   @map("is_vegan")
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz // field 16
  isActive               Boolean    @default(true) @map("is_active") // soft delete, INV-03, §4.7.1
  lowStockThreshold      Int        @default(5) @map("low_stock_threshold") // §4.7.2

  images       ProductImage[] // field 10 — 1 to 4
  ingredients  ProductIngredient[] // field 13 — structured, not JSON
  healthGoals  ProductHealthGoal[] // field 14 — many-to-many
  cartItems    CartItem[]
  orderItems   OrderItem[]
  favorites    Favorite[]
  funnelEvents FunnelEvent[]

  @@index([isActive, categoryId])
  @@index([price])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  url       String
  sortOrder Int     @default(0) @map("sort_order")

  @@index([productId])
  @@map("product_images")
}

// Field 13 — structured, drives search (REQ-F-010) and filtering (Table 2)
model ActiveIngredient {
  id       String              @id @default(uuid())
  name     String              @unique
  products ProductIngredient[]

  @@map("active_ingredients")
}

model ProductIngredient {
  id                 String           @id @default(uuid())
  productId          String           @map("product_id")
  product            Product          @relation(fields: [productId], references: [id])
  activeIngredientId String           @map("active_ingredient_id")
  activeIngredient   ActiveIngredient @relation(fields: [activeIngredientId], references: [id])
  amount             Decimal          @db.Decimal(10, 2)
  unit               String

  @@index([productId])
  @@index([activeIngredientId])
  @@map("product_ingredients")
}

model ProductHealthGoal {
  productId    String     @map("product_id")
  product      Product    @relation(fields: [productId], references: [id])
  healthGoalId String     @map("health_goal_id")
  healthGoal   HealthGoal @relation(fields: [healthGoalId], references: [id])

  @@id([productId, healthGoalId])
  @@map("product_health_goals")
}

// ── Cart ──────────────────────────────────────────────

// Guest identification mechanism — placeholder, DEC-024 open item 4
model Cart {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id") // nullable — null for a guest
  user      User?    @relation(fields: [userId], references: [id])
  sessionId String?  @map("session_id") // nullable — placeholder for a guest
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  items CartItem[]

  // DEC-055 (Accepted 2026-08-12). 🔴 ONE cart per identity. These were
  // INDEXES, not constraints, so concurrent POSTs both missed the lookup and
  // both created a cart; getCart's findFirst then saw one and every row in the
  // loser was invisible and unrecoverable — measured at 5 concurrent -> 3
  // carts.
  //
  // ⚠️ NOT a partial index, deliberately. Both columns are nullable and exactly
  // one is set; PostgreSQL treats NULLs as DISTINCT in a unique index, so each
  // constraint permits unlimited NULLs (every cart of the other kind) while
  // allowing one row per real identity. Prisma cannot express a filtered unique
  // index at all, which would force raw SQL that `migrate diff` cannot see —
  // losing the drift check is the larger cost.
  @@unique([userId])
  @@unique([sessionId])
  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String  @map("cart_id")
  cart      Cart    @relation(fields: [cartId], references: [id])
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  // DEC-055. One product, one line, per cart — and it is what makes the
  // upsert in cartService expressible.
  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

// ── Orders ────────────────────────────────────────────

// 🔴 MILESTONE-008 Checkpoint B (DEC-059). Everything added below exists for
// ONE reason: an order must FREEZE what was agreed, not point at a row that can
// change afterwards. That is INV-02's reasoning applied past the two columns it
// already covered — see MILESTONE_PLANS §8.3 and ISSUE-077.
model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique @map("order_number") // §2.6 — unique order number
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(pending_payment)
  totalAmount Decimal     @map("total_amount") @db.Decimal(10, 2)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  // ── INV-05, DEC-059 answer 1 ─────────────────────────────────────────────
  // 🔴 CLIENT-SUPPLIED and NOT NULL. `orderNumber` is unique but generated per
  // ATTEMPT, so it could never anchor idempotency (ISSUE-028). The client
  // generates one key per checkout attempt and resends the SAME one on retry;
  // the unique constraint is what makes the second attempt a no-op instead of
  // a second order.
  // ⚠️ NOT NULL deliberately. A nullable key would let an order exist with no
  // anchor, which is INV-05 made optional. Safe to require: 0 orders existed
  // when this migration ran.
  //
  // 🔴 SCOPED TO THE USER, not globally unique — corrected 2026-08-13 after
  // review. A GLOBAL unique makes the natural retry lookup
  // `findUnique({ where: { idempotencyKey } })`, with no user filter, because
  // the constraint never asked for one — so a key belonging to ANOTHER SHOPPER
  // matches and the retry hands back THEIR ORDER. The key is client-supplied,
  // so its value is attacker-controlled. Global uniqueness also lets one
  // account claim a key and block it for every other account, permanently.
  // The composite gives identical replay protection and makes the scoping
  // STRUCTURAL rather than something the service has to remember.
  idempotencyKey String @map("idempotency_key")

  // ── The frozen delivery details — ISSUE-077 gaps 2 and 3 ─────────────────
  // 🔴 COPIED, never a foreign key to `Address`. Address hangs off User and is
  // mutable: editing one would rewrite where a PAST order shipped, and
  // deleting one would leave the order pointing at nothing, because Address
  // has no soft-delete flag.
  // ⚠️ NULLABLE because SELF PICKUP HAS NO DELIVERY ADDRESS. The columns mirror
  // Address's own fields exactly — no field is invented here.
  shippingLine1   String? @map("shipping_line1")
  shippingCity    String? @map("shipping_city")
  shippingZipCode String? @map("shipping_zip_code")

  // 🔴 DEC-058 as amended: self pickup ₪0, courier and pickup point ₪30 free
  // over ₪249. FROZEN onto the order, because the day those numbers change an
  // old order's total must stay explainable.
  deliveryMethod DeliveryMethod @map("delivery_method")
  shippingCost   Decimal        @map("shipping_cost") @db.Decimal(10, 2)

  // REQ-F-047 requires a tracking number "where one exists". Nullable: most
  // orders have none for most of their life.
  trackingNumber String? @map("tracking_number")

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  funnelEvents  FunnelEvent[]

  // INV-05's database layer. See the note on `idempotencyKey` for why this is
  // composite rather than a bare `@unique` on the key.
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("orders")
}

// Frozen price and name — INV-02. Never references current Product values.
model OrderItem {
  id                  String  @id @default(uuid())
  orderId             String  @map("order_id")
  order               Order   @relation(fields: [orderId], references: [id])
  productId           String  @map("product_id") // reference — display/linking only
  product             Product @relation(fields: [productId], references: [id])
  quantity            Int
  unitPriceAtPurchase Decimal @map("unit_price_at_purchase") @db.Decimal(10, 2)

  // 🔴 THE FREEZE IS BILINGUAL — MILESTONE-008 Checkpoint B, ISSUE-077 gap 5.
  // There was ONE `productNameAtPurchase` column in a store that sells in two
  // languages. Every product carries `nameHe` AND `nameEn`, so a single column
  // froze whichever the code happened to pick, and an English shopper's order
  // history would have shown a Hebrew name forever.
  // INV-02 says the order records what was AGREED — and for someone shopping in
  // English, what was agreed is the English name.
  // ⚠️ The old column was RENAMED rather than kept alongside a new one: its
  // name no longer said which language it held. Safe — 0 order_items existed.
  // Both NOT NULL, because Product.nameHe and Product.nameEn both are.
  productNameHeAtPurchase String @map("product_name_he_at_purchase")
  productNameEnAtPurchase String @map("product_name_en_at_purchase")

  // 🔴 ONE PRODUCT, ONE LINE — DEC-055's cart-side rule applied to the order
  // side, added 2026-08-13 after review. The cart already guarantees one line
  // per product, so nothing legitimate needs two; without this, a partial retry
  // or a loop bug writes two lines for one product and then `totalAmount` and
  // the sum of the items disagree with no way to tell which is right.
  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  // 🔴 WHO DID IT — MILESTONE-008 Checkpoint B, ISSUE-077 gap 6.
  // DEC-050's framework says transitions are PERMISSION-CHECKED, but the record
  // that survived them could not say by whom: a shopper cancelling and an admin
  // cancelling were indistinguishable.
  // ⚠️ NULLABLE, and null MEANS SOMETHING: a SYSTEM transition with no human
  // actor — the simulated payment moving pending_payment -> paid. It is not
  // "unknown". See §8.9's table, where every row names its actor.
  // 🔴 `onDelete: Restrict`, NOT Prisma's default `SetNull` for an optional
  // relation. SetNull would turn a deleted user's transitions into NULLs —
  // indistinguishable from the SYSTEM transitions null already means. The
  // column would then answer "who did this?" with the same value for "nobody"
  // and "someone we removed". Restrict keeps null meaning exactly one thing.
  // ⚠️ It also blocks hard-deleting a user who has moved an order's status,
  // which is consistent: INV-03 makes this project soft-delete-only anyway.
  changedByUserId String? @map("changed_by_user_id")
  changedBy       User?   @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId])
  // 🔴 Postgres does NOT index a foreign-key column automatically and Prisma
  // does not add one. Without this, every `onDelete: Restrict` check on a user
  // delete is a sequential scan, and "which transitions did admin X make?" —
  // the MILESTONE-010 audit query this column exists for — is a full scan.
  // Every other relation in this file carries an explicit index; this was
  // breaking the file's own convention. Added 2026-08-13 after review.
  @@index([changedByUserId])
  @@map("order_status_history")
}

// ── Favourites, analytics ─────────────────────────────

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, productId])
  @@map("favorites")
}

model FunnelEvent {
  id        String          @id @default(uuid())
  eventType FunnelEventType @map("event_type")
  sessionId String          @map("session_id") // works for guests too
  userId    String?         @map("user_id")
  user      User?           @relation(fields: [userId], references: [id])
  productId String?         @map("product_id")
  product   Product?        @relation(fields: [productId], references: [id])
  orderId   String?         @map("order_id")
  order     Order?          @relation(fields: [orderId], references: [id])
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  // ISSUE-189 hardening (user-approved 2026-08-22; shapes redesigned by
  // the hundred-fifteenth-pass review): TWO secondaries on the
  // highest-write table, each earning its insert cost —
  //   (eventType, sessionId, createdAt): the checkout-started dedupe's
  //   eq/eq/range probe, AND a strict superset of the retired
  //   (eventType, createdAt) index, so the funnel groupBy still has its
  //   prefix;
  //   (createdAt, eventType, sessionId): covering for the dashboard's
  //   range-filtered aggregations (per-event distinct sessions), which a
  //   bare (createdAt) draft served not at all.
  @@index([eventType, sessionId, createdAt])
  @@index([createdAt, eventType, sessionId])
  @@map("funnel_events")
}
