{
  "name": "vitashop-server",
  "version": "0.0.0",
  "private": true,
  "description": "VitaShop API server — Express + TypeScript + Prisma",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:integration": "vitest run src/routes/catalog.integration.test.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:accounts": "tsx prisma/seedAccounts.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.3",
    "prisma": "7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}
