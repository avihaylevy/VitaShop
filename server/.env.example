# Copy to .env and fill in locally. Never commit .env — see .gitignore.

# postgresql://user:password@localhost:5432/db_name?schema=public
DATABASE_URL=

# DEC-010 — CORS is restricted to this one origin, never "*".
CLIENT_ORIGIN=http://localhost:5173

PORT=3000

# Session secret — REQUIRED as of MILESTONE-006 Checkpoint C. The server
# now refuses to start without it (DEC-018 / clause A6): there is no default
# and no generated fallback, because a secret that changes on restart or that
# anyone can guess is worse than an obvious failure.
#
# Generate your own long random value locally, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# 🔴 Never commit a real value. This file is the contract; .env holds the secret.
SESSION_SECRET=

# Path to the VitaShop memory system (outside this repo). Optional:
# scripts/check-catalogue-facts.py skips loudly when it is not set.
VITASHOP_MEMORY_DIR=

# ── Development accounts — ISSUE-083 ──────────────────────────────────────
# Two accounts so the project can be exercised by hand: an ADMIN (who can move
# an order through §8.9's fulfilment transitions) and an ordinary SHOPPER.
#
#   npm run seed:accounts
#
# 🔴 THERE IS NO DEFAULT. The script REFUSES to run if these are unset, rather
# than inventing a password — a default credential in a seed script becomes a
# real one the moment anyone points it at something that is not a laptop.
#
# 🔴 Never commit real values. This file is the contract; .env holds them, and
# .env is git-ignored. The seeder also refuses any database that is not
# localhost/vitashop_dev.
#
# Re-running the script re-hashes from these values, so changing a password
# here and re-running is the supported way to reset one.
SEED_ADMIN_EMAIL=admin@vitashop.local
SEED_ADMIN_PASSWORD=
SEED_SHOPPER_EMAIL=shopper@vitashop.local
SEED_SHOPPER_PASSWORD=

# MILESTONE-011 / DEC-091 — the AI agent's provider selector (ARCH-001).
# 🔴 "mock" is the only implementation that exists (DEC-014: no key, no
# vendor SDK, no real call — a real provider is the user's separate,
# explicit, per-switch decision). Unknown or missing values also resolve
# to the mock; the variable exists so a future provider is one env change.
AI_PROVIDER=mock

# DEC-094 — the Groq provider (the only real provider implemented).
# 🔴 The KEY is created and placed by the USER ONLY (DEC-014,
# quality/SECRETS_AND_KEYS.md) — an agent never obtains or configures one.
# AI_PROVIDER=groq with a missing/empty key falls back LOUDLY to the mock;
# the server never refuses to boot over an AI config.
# GROQ_MODEL overrides the model id (default: openai/gpt-oss-120b — Groq's
# recommended replacement after the June-2026 70B deprecation), so a future
# deprecation is an env edit, not a code change.
GROQ_API_KEY=
GROQ_MODEL=
