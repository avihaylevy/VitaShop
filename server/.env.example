# Copy to .env and fill in locally. Never commit .env — see .gitignore.

# postgresql://user:password@localhost:5432/db_name?schema=public
DATABASE_URL=

# DEC-010 — CORS is restricted to this one origin, never "*".
CLIENT_ORIGIN=http://localhost:5173

PORT=3000

# Session secret — needed once express-session is added (deferred, not
# part of MILESTONE-002). Leave empty until then.
SESSION_SECRET=
